{
	"name": "Night Crawler",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"../docker-compose.override.yml"
	],
	"service": "web",
	// Runs on the host before Compose starts: `keycloak` joins the
	// external `identity` network, which Compose won't create (`make up`
	// does the same through its `identity-network` target).
	"initializeCommand": "docker network inspect identity >/dev/null 2>&1 || docker network create identity",
	"runServices": [
		"db",
		"redis",
		"rabbitmq",
		"keycloak_db",
		"keycloak",
		"web",
		"celery_worker",
		"celery_beat",
		"frontend"
	],
	"workspaceFolder": "/apps/martiadrogue/night-crawler",
	"overrideCommand": false,
	"remoteUser": "nightcrawler-app",
    "containerUser": "scrapeotron-app",
    "customizations": {
        "vscode": {
            "runArgs": [
                "--add-host=host.docker.internal:host-gateway"
            ],
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff"
            ],
            "settings": {
                "devContainers.serverStoragePath": "/apps/martiadrogue/night-crawler/.vscode-server",
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.typeCheckingMode": "basic",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                }
            }
        }
    }
}
