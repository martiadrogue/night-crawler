APP_NAME=Night Crawler API
APP_DESCRIPTION=Night Crawler API
APP_VERSION=0.1.0
APP_ENV=development
ROOT_PATH=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MONGO_DATABASE=night_crawler
MONGO_USER=nightcrawler
MONGO_PASSWORD=change-me

RABBITMQ_USER=nightcrawler
RABBITMQ_PASSWORD=change-me
# Production gives each app its own vhost on a shared RabbitMQ.
# RABBITMQ_VHOST=/

# Keycloak (http://localhost:8180), shared with Night Crawler Importer.
# Secrets: generate each with `openssl rand -hex 32`.
KEYCLOAK_DB_PASSWORD=change-me
# Master-realm admin console login.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# The `night-crawler` realm's first admin, created on its first import.
KC_SEED_ADMIN_EMAIL=admin@example.com
KC_SEED_ADMIN_PASSWORD=AdminPass1
KC_NIGHT_CRAWLER_UI_SECRET=change-me
KC_NIGHT_CRAWLER_API_SECRET=change-me
KC_IMPORTER_UI_SECRET=change-me
KC_IMPORTER_API_SECRET=change-me
# Each UI's public URL, for its client's redirect URI; these defaults
# match the Compose stacks.
KC_NIGHT_CRAWLER_UI_URL=http://localhost:3000
KC_IMPORTER_UI_URL=http://localhost:3100
# Tokens the API accepts; the defaults match the Compose stack.
OIDC_ISSUER=http://localhost:8180/realms/night-crawler
OIDC_JWKS_URL=http://keycloak:8080/realms/night-crawler/protocol/openid-connect/certs
OIDC_AUDIENCE=night-crawler-api
# Where users are managed; Compose sets KEYCLOAK_ADMIN_CLIENT_SECRET
# from KC_NIGHT_CRAWLER_API_SECRET.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=night-crawler
KEYCLOAK_ADMIN_CLIENT_ID=night-crawler-api
# The Reflex UI's login (frontend/docs/ARCHITECTURE.md#authentication);
# Compose sets OIDC_CLIENT_SECRET from KC_NIGHT_CRAWLER_UI_SECRET.
OIDC_BROWSER_URL=http://localhost:8180/realms/night-crawler
OIDC_INTERNAL_URL=http://keycloak:8080/realms/night-crawler
OIDC_CLIENT_ID=night-crawler-ui
APP_URL=http://localhost:3000

# Instruction Generations' browser agent (Browser Use on Gemini). Without
# a key every generation fails with "GEMINI_API_KEY must be set.".
GEMINI_API_KEY=
# Google's alias for its newest Flash model; pinned ids such as
# gemini-2.5-flash answer 404 to projects created after they closed.
GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL's free-tier quota, shared by every worker. Google shows
# your project's values in AI Studio (aistudio.google.com/rate-limit)
# and changes them without notice; these are gemini-2.5-flash's there
# on 2026-10-06: check your model's. A spent daily budget fails
# generations until it frees.
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_DAY=1500
GEMINI_TOKENS_PER_MINUTE=1000000
GEMINI_MAX_RETRY_ATTEMPTS=3
# Instruction synthesis: files Gemini may write per generation before it
# fails, how much of each response body (and of all bodies) it is shown,
# and the analytics/ads hosts dropped from recordings (comma-separated;
# leave unset for the built-in list).
SYNTHESIS_MAX_ATTEMPTS=3
SYNTHESIS_BODY_MAX_BYTES=16384
SYNTHESIS_TOTAL_BODY_MAX_BYTES=131072
# SYNTHESIS_IGNORED_HOSTS=google-analytics.com,googletagmanager.com,doubleclick.net
AGENT_MAX_STEPS=40
AGENT_MAX_PAGES=5
AGENT_TIMEOUT_SECONDS=600
# Per response body kept in a recording; the whole stored recording.
AGENT_RESPONSE_BODY_MAX_BYTES=65536
GENERATION_RECORDING_MAX_BYTES=1048576

# Grafana login (`make up-observability`); defaults to admin / admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Where the app pushes traces and metrics; leave empty, since
# `make up-observability` sets it (http://alloy:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=

API_BASE_URL=http://web:8000
REFLEX_API_URL=http://localhost:8001
