    propagate: false
  uvicorn.error:
    handlers: [error_file, console]
    level: INFO
    propagate: false
  uvicorn.access:
    handlers: [access_file, console]
    level: INFO
    propagate: false
  night_crawler:
    handlers: [error_file, console]
    level: INFO
    propagate: false
