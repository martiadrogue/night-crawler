    assert ["session_id", "lang", "theme"] == harvested["cookie_name[]"]
    assert ["abc123", "ca", "dark"] == harvested["cookie_value[]"]


@pytest.mark.anyio
async def test_without_a_browser_a_click_reads_its_children_once_as_a_list():
