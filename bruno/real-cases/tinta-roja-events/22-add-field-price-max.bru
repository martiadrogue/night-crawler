meta {
  name: Add field price_max
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/templates/{{tintaRojaShowTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "(substring-before(substring-after(normalize-space(.//div[contains(@class, 'flex-column')]/text()[normalize-space()]), ', '), '€'))",
    "type": "value",
    "title": "price_max",
    "parent_selector_id": "{{tintaRojaDatesIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The box-office price in euros: the number before the `€` after the
  comma (`13`).
}
