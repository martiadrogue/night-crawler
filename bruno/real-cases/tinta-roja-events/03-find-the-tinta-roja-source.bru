meta {
  name: Find the Tinta Roja source
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/sources
  body: none
  auth: inherit
}

script:post-response {
  const source = res.body.find((item) => item.name === "Tinta Roja");
  bru.setEnvVar("tintaRojaSourceId", source.id);
}

tests {
  test("lists the Tinta Roja source", function () {
    expect(res.body.map((item) => item.name)).to.include("Tinta Roja");
  });
}
