meta {
  name: Find the events dataset
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/datasets
  body: none
  auth: inherit
}

script:post-response {
  const dataset = res.body.find((item) => item.name === "events");
  bru.setEnvVar("eventsDatasetId", dataset.id);
}

tests {
  test("lists the events dataset", function () {
    expect(res.body.map((item) => item.name)).to.include("events");
  });
}

docs {
  Reuses the `events` Dataset that `comedy-clubhouse-events/` creates
  (its request 04): run that folder first.
}
