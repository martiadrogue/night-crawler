meta {
  name: List the run history
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/crawlers/{{theforkCrawlerId}}/executions?limit=20&offset=0
  body: none
  auth: inherit
}

params:query {
  limit: 20
  offset: 0
}

tests {
  test("returns a page of the crawler's runs", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body).to.have.property("has_more");
  });
}

docs {
  The crawler's runs, newest first, 20 at a time (`offset` for the next
  page). Test runs are left out unless `queue=testing`; `status` filters
  too. Each run carries `dataset.row_count` (records extracted) once it
  has a CSV, `null` while pending or running.
}
