meta {
  name: Create the execution
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/crawlers/{{comedyClubhouseCrawlerId}}/executions
  body: json
  auth: inherit
}

body:json {
  {
    "context": {}
  }
}

script:post-response {
  bru.setEnvVar("comedyClubhouseExecutionId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  Creates a `pending` run with nothing seeded: one request fetches every
  upcoming event. Download its Sample CSV from the Runs page once it ends.
}
