meta {
  name: Add field organizers
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/templates/{{comedyClubhouseEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "organizer[].organizer",
    "type": "value",
    "title": "organizers",
    "parent_selector_id": "{{comedyClubhouseIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The organizers' names; empty when the event lists none.
}
