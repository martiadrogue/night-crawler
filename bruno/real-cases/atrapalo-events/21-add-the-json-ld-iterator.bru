meta {
  name: Add the JSON-LD iterator
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/templates/{{atrapaloShowTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "//script[@type='application/ld+json'][contains(., 'ComedyEvent')]",
    "type": "iterator"
  }
}

script:post-response {
  bru.setEnvVar("atrapaloScriptsIteratorId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The page's JSON-LD script that holds the performances. A `<script>`
  holding JSON is read as JSON, so the selectors under it use JMESPath
  (DOMAIN_MODEL §4.5).
}
