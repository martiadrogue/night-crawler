meta {
  name: Add the first page show_path selector
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/templates/{{atrapaloFirstPageTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "(string(@data-url))",
    "type": "value",
    "title": "show_path",
    "parent_selector_id": "{{atrapaloFirstPageCardsIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The card's `data-url`, e.g. `/entradas/lo-nunca-visto-berto-romero-en-barcelona_e4948781/`.
  Not a Dataset field, so it collects in the Context as `show_path[]`,
  which the show template fans out over: one request per distinct show.
}
