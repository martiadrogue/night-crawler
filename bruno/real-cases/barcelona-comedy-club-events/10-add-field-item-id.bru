meta {
  name: Add field item_id
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/templates/{{barcelonaComedyClubEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "join('-', [to_string(event_id), to_string(ri)])",
    "type": "value",
    "title": "item_id",
    "parent_selector_id": "{{barcelonaComedyClubIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The event's WordPress id and the date's repeat index, e.g. `2564-1`:
  unique per date.
}
