meta {
  name: Add field end_date
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/templates/{{barcelonaComedyClubEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "format_epoch(event_end_unix, '%Y-%m-%d %H:%M:%S', 'UTC')",
    "type": "value",
    "title": "end_date",
    "parent_selector_id": "{{barcelonaComedyClubIteratorId}}"
  }
}

tests {
