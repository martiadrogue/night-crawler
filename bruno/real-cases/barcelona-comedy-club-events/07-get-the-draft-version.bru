meta {
  name: Get the draft version
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/crawlers/{{barcelonaComedyClubCrawlerId}}/versions
  body: none
  auth: inherit
}

script:post-response {
  const draft = res.body.find((version) => version.status === "draft");
  bru.setEnvVar("barcelonaComedyClubVersionId", draft.id);
  bru.setEnvVar("barcelonaComedyClubEventsTemplateId", draft.message_template_root_id);
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
}
