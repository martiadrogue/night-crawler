meta {
  name: Find the Barcelona Comedy Club source
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/sources
  body: none
  auth: inherit
}

script:post-response {
  const source = res.body.find((item) => item.name === "Barcelona Comedy Club");
  bru.setEnvVar("barcelonaComedyClubSourceId", source.id);
}

tests {
  test("lists the Barcelona Comedy Club source", function () {
    expect(res.body.map((item) => item.name)).to.include("Barcelona Comedy Club");
  });
}
