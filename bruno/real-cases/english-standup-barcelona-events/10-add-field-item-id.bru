meta {
  name: Add field item_id
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/templates/{{englishStandupEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "(substring-after(.//a[@class='eventlist-title-link']/@href, '/events/'))",
    "type": "value",
    "title": "item_id",
    "parent_selector_id": "{{englishStandupIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The event's slug in its URL (`/events/{slug}`), unique per event.
}
