meta {
  name: Add field address
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/templates/{{englishStandupEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "(substring-after(.//a[@class='eventlist-meta-address-maplink']/@href, '?q='))",
    "type": "value",
    "title": "address",
    "parent_selector_id": "{{englishStandupIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The full address, from the Google Maps link's query (e.g.
  `6 Via Laietana Barcelona, Catalunya, 08003 España`).
}
