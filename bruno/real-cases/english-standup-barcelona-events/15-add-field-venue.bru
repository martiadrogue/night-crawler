meta {
  name: Add field venue
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/templates/{{englishStandupEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "(normalize-space(.//li[contains(@class, 'eventlist-meta-address')]/text()))",
    "type": "value",
    "title": "venue",
    "parent_selector_id": "{{englishStandupIteratorId}}"
  }
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  The venue's name: the address line's own text, without its `(map)` link.
}
