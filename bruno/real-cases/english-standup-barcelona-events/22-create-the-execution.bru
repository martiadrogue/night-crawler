meta {
  name: Create the execution
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/crawlers/{{englishStandupCrawlerId}}/executions
  body: json
  auth: inherit
}

body:json {
  {
    "context": {}
  }
}

script:post-response {
  bru.setEnvVar("englishStandupExecutionId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  Creates a `pending` run with nothing seeded: one request reads every
  upcoming event from `/events`.
}
