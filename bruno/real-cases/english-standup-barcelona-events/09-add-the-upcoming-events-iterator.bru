meta {
  name: Add the upcoming events iterator
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/templates/{{englishStandupEventsTemplateId}}/selectors
  body: json
  auth: inherit
}

body:json {
  {
    "path": "article.eventlist-event--upcoming",
    "type": "iterator"
  }
}

script:post-response {
  bru.setEnvVar("englishStandupIteratorId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  One `events` row per upcoming event. Past events
  (`eventlist-event--past`) are left out.
}
