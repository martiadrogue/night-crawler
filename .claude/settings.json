{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(rtk*)",
      "Bash(grep*)",
      "Bash(rtk docker *)",
      "Bash(pip download *)",
      "Bash(pip install *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -u normal -i terminal 'Claude Code' \"$(jq -r '.message // \"Claude Code needs your attention\"')\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  }
}
